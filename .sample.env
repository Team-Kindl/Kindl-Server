SPRING_PROFILES_ACTIVE=

# MySQL 8.4
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# 기동 시 Flyway 실행 여부 (local·dev 기본 true, prod 기본 false)
FLYWAY_ON_STARTUP=

# 서버 인스턴스마다 다른 TSID 노드 번호 (0~1023)
TSID_NODE=

# HS256 서명 키, 각 32바이트 이상. 두 값은 달라야 한다
JWT_ACCESS_KEY=
JWT_SIGNUP_KEY=

# 쉼표로 구분한 client ID 목록. 비워 두면 그 제공자의 로그인을 받지 않는다
GOOGLE_CLIENT_IDS=
KAKAO_CLIENT_IDS=
APPLE_CLIENT_IDS=
